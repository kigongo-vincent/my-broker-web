VITE_API_URL=http://localhost:3000/api/v1

# The backend supports feed filters and free-text search.
VITE_FEED_BACKEND_ENABLED=true

# The TikTok scraper supports property feed filters that overlap with the backend.
# Set to true to include it in round-robin feed/filter requests.
VITE_FEED_TIKTOK_ENABLED=false

# Required when VITE_FEED_TIKTOK_ENABLED=true. The scraper defaults to port 3000;
# use a separate port (for example APP_PORT=3001) when running beside the backend.
VITE_TIKTOK_API_URL=http://localhost:3001/api/v1
